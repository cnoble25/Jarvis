# ==============================================================================
# Jarvis Desktop AI Assistant Environment Configuration
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Anthropic Claude API Key (Main LLM Engine)
# Required for agentic tool selection, reasoning, and prompt caching.
# Get your API key from https://console.anthropic.com/
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# Local Ollama Settings (Optional Memory / Local Fallback LLM)
# Default local endpoint for Ollama (e.g. http://localhost:11434)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# AWS S3 Cloud Sync (Optional Memory Backup)
# ------------------------------------------------------------------------------
JARVIS_S3_SYNC_ENABLED=false
JARVIS_S3_BUCKET_ARN=arn:aws:s3:::my-jarvis-transcripts-bucket
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# ------------------------------------------------------------------------------
# Developer & Telemetry Settings
# Set to 1 to enable verbose prompt caching telemetry in console logs
# ------------------------------------------------------------------------------
JARVIS_DEBUG_LLM=0
