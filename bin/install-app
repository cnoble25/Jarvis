#!/usr/bin/env bash
# Install Jarvis as an app for this user (no root needed):
#   - `jarvis` on the PATH (~/.local/bin)
#   - an app-menu entry with the Jarvis icon
#   - a systemd user service that starts Jarvis quietly at login and restarts it if it crashes
# It runs from this folder and its .venv: after a `git pull`, restart it to pick up changes
# (systemctl --user restart jarvis).
#
#   bin/install-app              install and enable start at login
#   bin/install-app --no-login   install the launcher and menu entry only
#   bin/install-app --uninstall  remove all of it (leaves the repo, settings and logs alone)
set -euo pipefail
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
BIN="$HOME/.local/bin"
APPS="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
ICONS="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/scalable/apps"
UNITS="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
LOGS="${XDG_DATA_HOME:-$HOME/.local/share}/jarvis"

if [ "${1:-}" = "--uninstall" ]; then
  systemctl --user disable --now jarvis.service 2>/dev/null || true
  rm -f "$UNITS/jarvis.service" "$APPS/jarvis.desktop" "$ICONS/jarvis.svg"
  [ "$(readlink -f "$BIN/jarvis" 2>/dev/null)" = "$REPO/bin/jarvis" ] && rm -f "$BIN/jarvis"
  systemctl --user daemon-reload
  update-desktop-database "$APPS" 2>/dev/null || true
  echo "Removed the Jarvis launcher, menu entry and login service."
  exit 0
fi

[ -x "$REPO/.venv/bin/python" ] || { echo "No .venv in $REPO: create it and install requirements.txt first." >&2; exit 1; }
mkdir -p "$BIN" "$APPS" "$ICONS" "$UNITS" "$LOGS"
chmod +x "$REPO/bin/jarvis"
ln -sfn "$REPO/bin/jarvis" "$BIN/jarvis"
cp "$REPO/ui/icons/jarvis.svg" "$ICONS/jarvis.svg"

cat > "$APPS/jarvis.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Jarvis
GenericName=Voice assistant
Comment=Hold your shortcut and talk to your desktop
Exec=$REPO/bin/jarvis
Icon=jarvis
Terminal=false
Categories=Utility;Accessibility;
Keywords=voice;assistant;speech;
StartupWMClass=Jarvis
StartupNotify=false
Actions=quit;

[Desktop Action quit]
Name=Quit Jarvis
Exec=$REPO/bin/jarvis --quit
DESKTOP

cat > "$UNITS/jarvis.service" <<UNIT
[Unit]
Description=Jarvis voice assistant
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=$REPO
ExecStart=$REPO/.venv/bin/python $REPO/main.py --background
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
# Leave what Jarvis started (timers, Ollama) running when Jarvis itself restarts.
KillMode=process
StandardOutput=append:$LOGS/jarvis.log
StandardError=inherit

[Install]
WantedBy=graphical-session.target
UNIT

systemctl --user daemon-reload
update-desktop-database "$APPS" 2>/dev/null || true
if [ "${1:-}" != "--no-login" ]; then
  systemctl --user enable jarvis.service
  echo "Jarvis will start at login (quietly: open the dashboard from the app menu)."
fi
echo "Installed: 'Jarvis' in the app menu, 'jarvis' on your PATH, logs in $LOGS/jarvis.log."
echo "Start it now with: systemctl --user start jarvis"
